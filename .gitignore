# Terraform working directory
.terraform/

# Terraform state files
*.tfstate
*.tfstate.*

# Terraform variable files (may contain secrets)
*.tfvars
*.tfvars.json

# Terraform plan files
*.tfplan
*tfplan*

# Crash logs
crash.log
crash.*.log

# Lock information
.terraform.tfstate.lock.info

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI configuration
.terraformrc
terraform.rc

# Dependency lock file
# Uncomment the next line if you don't want to version the provider lock file.
# In most projects, it's recommended to COMMIT this file.
# .terraform.lock.hcl

# IDE files
.vscode/
.idea/

# OS files
.DS_Store
Thumbs.db